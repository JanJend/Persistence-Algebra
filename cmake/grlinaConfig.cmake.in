# NEW: exported header-only target and its public dependencies.
@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.30)
    find_dependency(Boost CONFIG COMPONENTS timer)
else()
    find_dependency(Boost COMPONENTS timer)
endif()
if(@OpenMP_CXX_FOUND@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/grlinaTargets.cmake")
check_required_components(grlina)
